# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required: Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for chat (agent responses)
# Options: gemini-3.5-flash-lite (1,500 free requests/day), gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Model to use for generating document embeddings
# Options: models/gemini-embedding-001, models/gemini-embedding-2
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Directory where ChromaDB persists vector data on disk
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Name of the ChromaDB collection
CHROMA_COLLECTION_NAME=employee_documents

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of document chunks to retrieve per query
RETRIEVAL_TOP_K=4

# Minimum relevance score (0-1) to accept a chunk.
# Chunks below this threshold are rejected (hallucination prevention).
# Lower value = more permissive, Higher value = stricter
RETRIEVAL_SCORE_THRESHOLD=0.30

# ── RAG Chunking ──────────────────────────────────────────────────────────────
# Size of each text chunk in characters
CHUNK_SIZE=800

# Number of characters to overlap between consecutive chunks
CHUNK_OVERLAP=150

# ── Data Paths ────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=./data/documents
EMPLOYEES_FILE=./data/employees.json
LEAVE_REQUESTS_FILE=./data/leave_requests.json

# ── API ───────────────────────────────────────────────────────────────────────
# React frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Secret key to protect the POST /ingest endpoint
INGEST_SECRET=dev-ingest-secret

# ── Conversation Memory ───────────────────────────────────────────────────────
# Maximum number of messages to keep in memory per conversation
MAX_CONVERSATION_HISTORY=20
